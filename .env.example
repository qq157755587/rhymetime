# RhymeTime AI Environment Configuration

# Gemini API Configuration (Recommended for English TTS)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Google Cloud Configuration (Backup for TTS/STT)
VITE_GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
VITE_GOOGLE_CLOUD_PROJECT_ID=your-project-id

# OpenAI Configuration (Alternative LLM and TTS)
VITE_OPENAI_API_KEY=your-openai-api-key-here

# TTS/STT Service Configuration
VITE_TTS_PROVIDER=gemini  # gemini | google-cloud | openai | web-speech
VITE_STT_PROVIDER=google-cloud  # google-cloud | openai | web-speech
VITE_LANGUAGE_MODE=en  # Force English mode

# Gemini TTS Configuration (English Voice)
VITE_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
VITE_GEMINI_TTS_LANGUAGE=en-US
VITE_GEMINI_TTS_VOICE=child-friendly
VITE_GEMINI_TTS_SPEED=0.9

# Google Cloud TTS Configuration (English Voice)
VITE_GOOGLE_TTS_LANGUAGE_CODE=en-US
VITE_GOOGLE_TTS_VOICE_NAME=en-US-Journey-D
VITE_GOOGLE_TTS_AUDIO_ENCODING=MP3
VITE_GOOGLE_TTS_SPEAKING_RATE=0.9

# Google Cloud STT Configuration (English Speech Recognition)
VITE_GOOGLE_STT_LANGUAGE_CODE=en-US
VITE_GOOGLE_STT_ENABLE_WORD_TIME_OFFSETS=true
VITE_GOOGLE_STT_ENABLE_WORD_CONFIDENCE=true
VITE_GOOGLE_STT_MODEL=latest_long

# Application Configuration
VITE_APP_NAME=RhymeTime AI
VITE_APP_VERSION=1.0.0
VITE_DEBUG_MODE=false